script = ExtResource("2_8vcfy")
KeyboardText = "Press W to move Up
Press S to move Down
Press A to move Left
Press D to move Right
Press E to open/close books
Press T to translate books
Press Esc to pause/unpause
Press Q to quit when paused"
VocalText = "Say \"High\" to move Up
Say \"Low\" to move Down
Say \"Left\" to move Left
Say \"Right\" to move Right
Say \"Open/Close\" to open/close books
Press \"Translate\" to translate books
Press \"Pause/Unpause\" to pause/unpause
Press \"Quit\" to quit when paused"
SoundText = "Hum High to move Up
Hum Low to move Down
Whistle High to move Left
Whistle Low to move Right
Cough to open/close books
Click tongue to translate books
Snap once to pause/unpause
Snap twice to quit when paused"

